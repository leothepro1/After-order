{
  "id": "provetiketter",
  "title": "Klistermärken",
  "i18n": { "en": { "title": "Stickers" } },
  "version": "2.0.1",
  "currency": "EUR",
  "options": [
    {
      "id": "currency",
      "label": "Currency",
      "type": "hidden",
      "default": "EUR",
      "export": false
    },
    {
      "id": "size",
      "label": "Storlek (B×H)",
      "i18n": { "en": { "label": "Size (W×H)" } },
      "type": "select",
      "default": "custom",
      "choices": [
        {
          "value": "custom",
          "code": "custom",
          "label": "Egen storlek (cm)",
          "i18n": { "en": { "label": "Custom size (cm)" } }
        }
      ],
      "ui": { "component": "custom-size-only" },
      "export": true
    },
    {
      "id": "qty",
      "label": "Quantity",
      "i18n": { "en": { "label": "Quantity" } },
      "type": "hidden",
      "default": 1,
      "export": false
    }
  ],
  "tables": {},
  "formulas": {
    "unit_price": "(size_w_cm && size_h_cm) ? ((size_w_cm <= 9 && size_h_cm <= 9) ? 8 : (size_w_cm <= 15 && size_h_cm <= 15) ? 11 : 21) : 0",
    "total_price": "unit"
  },
  "export": ["size_w_cm", "size_h_cm"]
}
